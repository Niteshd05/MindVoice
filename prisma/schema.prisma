// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  username  String     @unique
  password  String
  theme     String     @default("warm-earth")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  // Relations
  testResults TestResult[]
  messages    Message[]
  dashboards  Dashboard[]
}

model TestResult {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Test answers
  answers   Json // Array of {questionId, selectedOption}
  theme     String // Assigned theme
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  @@index([userId])
}

model Dashboard {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Analytics data
  emotionalState Json // Current emotional state based on test
  stressLevel    Int  // 0-100
  wellnessScore  Int  // 0-100
  insights       Json // Analysis insights
  
  updatedAt DateTime   @updatedAt
  
  @@unique([userId])
  @@index([userId])
}

model Message {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  role      String     // "user" or "assistant"
  content   String     @db.Text
  
  createdAt DateTime   @default(now())
  
  @@index([userId])
}
